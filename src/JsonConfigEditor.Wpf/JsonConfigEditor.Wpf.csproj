<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>JsonConfigEditor.Wpf</RootNamespace>
    <!-- WPF0001: Fluent-Theme (ThemeMode) ist in .NET 10 noch als experimentell markiert -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JsonConfigEditor.Core\JsonConfigEditor.Core.csproj" />
  </ItemGroup>
</Project>
