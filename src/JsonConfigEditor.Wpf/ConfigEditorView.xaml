<UserControl x:Class="JsonConfigEditor.Wpf.ConfigEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JsonConfigEditor.Wpf.ViewModels"
             xmlns:local="clr-namespace:JsonConfigEditor.Wpf"
             x:Name="Root"
             FontSize="14"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/JsonConfigEditor.Wpf;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Rechtsklick auf ein Pfadfeld. x:Shared=False: jede Karte bekommt ihr eigenes Menü (DataContext) -->
            <ContextMenu x:Key="PathMenu" x:Shared="False">
                <MenuItem Header="Ordner öffnen" Command="{Binding OpenFolderCommand}" FontWeight="SemiBold">
                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE838;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Durchsuchen …" Command="{Binding BrowseCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE712;" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Pfad kopieren" Command="{Binding CopyPathCommand}">
                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Command="ApplicationCommands.Cut" />
                <MenuItem Command="ApplicationCommands.Copy" />
                <MenuItem Command="ApplicationCommands.Paste" />
            </ContextMenu>

            <!-- ============================== Karte pro Feld ============================== -->
            <DataTemplate x:Key="FieldCard" DataType="{x:Type vm:FieldViewModel}">
                <Border Style="{StaticResource Card}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="{Binding Label}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Kopf: Label + Etiketten -->
                        <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" Margin="8,0,0,0" FontSize="13"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       ToolTip="{Binding LockToolTip}" AutomationProperties.Name="gesperrt"
                                       Visibility="{Binding ShowLock, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" Margin="8,0,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       ToolTip="Gilt nach einem Neustart der App" AutomationProperties.Name="Neustart nötig"
                                       Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVis}}" />
                            <Border Style="{StaticResource Badge}" Visibility="{Binding ShowOrigin, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding DefaultText}">
                                <TextBlock Text="{Binding OriginText}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </WrapPanel>

                        <!-- Beschreibung -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0" Style="{StaticResource SecondaryText}"
                                   Text="{Binding Description}" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />

                        <!-- Rechte Spalte: Bedienelement -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Command="{Binding ResetCommand}" Margin="0,0,6,0"
                                    ToolTip="{Binding DefaultText, StringFormat=Zurücksetzen ({0})}"
                                    AutomationProperties.Name="Zurücksetzen"
                                    Visibility="{Binding CanReset, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" />
                            </Button>

                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                      IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Label}"
                                      Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsNumber, Converter={StaticResource BoolToVis}}">
                                <TextBox Width="110" TextAlignment="Right" VerticalContentAlignment="Center"
                                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEdit}" LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                         AutomationProperties.Name="{Binding Label}" />
                                <TextBlock Text="{Binding Unit}" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="24"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <TextBox Width="210" VerticalContentAlignment="Center"
                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEdit}" LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                     AutomationProperties.Name="{Binding Label}"
                                     Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />

                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsArray, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ArraySummary}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Button Command="{Binding OpenInEditorCommand}" Padding="10,4"
                                        ToolTip="Listen bearbeitest du in v1 direkt im JSON (User-Datei)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70F;" Margin="0,0,6,0" FontSize="12" />
                                        <TextBlock Text="Im Texteditor öffnen" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Pfad: breites Feld + Ordner öffnen + Durchsuchen, Rechtsklick = Menü -->
                        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Visibility="{Binding IsPath, Converter={StaticResource BoolToVis}}"
                              Background="Transparent" ContextMenu="{StaticResource PathMenu}" ContextMenuService.ShowOnDisabled="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- TextBox: Rechtsklick geht auch bei gesperrtem Feld (Ordner öffnen, Pfad kopieren) -->
                            <TextBox VerticalContentAlignment="Center" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEdit}" LostFocus="OnFieldLostFocus" KeyDown="OnFieldKeyDown"
                                     ContextMenu="{StaticResource PathMenu}" ContextMenuService.ShowOnDisabled="True"
                                     AutomationProperties.Name="{Binding Label}" />
                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,4" Command="{Binding OpenFolderCommand}"
                                    ToolTip="{Binding OpenFolderTooltip}" AutomationProperties.Name="{Binding OpenFolderTooltip}">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" />
                            </Button>
                            <Button Grid.Column="2" Margin="6,0,0,0" Padding="10,4" Command="{Binding BrowseCommand}"
                                    ToolTip="Durchsuchen …" AutomationProperties.Name="Durchsuchen">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE712;" />
                            </Button>
                        </Grid>

                        <!-- Statuszeile: Fehler, Pfadprüfung, Info -->
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xEA39;" FontSize="12" Margin="0,0,6,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12.5"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasPathStatus, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="12"
                                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                               Visibility="{Binding PathOk, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" FontSize="12"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding PathWarning, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xEA39;" FontSize="12"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               Visibility="{Binding PathError, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <TextBlock Text="{Binding PathStatus}" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <TextBlock Text="{Binding ExpandedPath, StringFormat=→ {0}}" Style="{StaticResource SecondaryText}"
                                       Visibility="{Binding ExpandedPath, Converter={StaticResource NotEmptyToVis}}" />
                            <TextBlock Text="{Binding InfoText}" Style="{StaticResource SecondaryText}" FontStyle="Italic"
                                       Visibility="{Binding InfoText, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="CardGrid">
                <local:CardPanel Columns="{Binding DataContext.Columns, ElementName=Root}" />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <!-- ============================== Ladefehler ============================== -->
        <Border Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}" Padding="32"
                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
            <StackPanel>
                <TextBlock Style="{StaticResource IconText}" Text="&#xEA39;" FontSize="32" HorizontalAlignment="Left"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <TextBlock Text="Einstellungen konnten nicht geladen werden" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8" />
                <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Style="{StaticResource SecondaryText}" FontSize="14" />
                <Button Content="Andere Einstellungen öffnen…" Command="{Binding OpenOtherCommand}" HorizontalAlignment="Left"
                        Padding="14,5" Margin="0,16,0,0"
                        Visibility="{Binding CanOpenOther, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="F3 zeigt Aufruf und Pfade." Style="{StaticResource SecondaryText}" Margin="0,16,0,0" />
            </StackPanel>
        </Border>

        <!-- ============================== F3: Debug-Infos ============================== -->
        <Border Panel.ZIndex="20" HorizontalAlignment="Right" VerticalAlignment="Stretch" MaxWidth="760" Margin="160,12,12,12"
                CornerRadius="8" BorderThickness="1" Padding="14,10"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                Visibility="{Binding ShowDebug, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25" />
            </Border.Effect>
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Command="{Binding CopyDebugCommand}" Padding="10,3" Margin="0,0,6,0" ToolTip="Alles in die Zwischenablage (für ein Ticket)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Kopieren" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenLogCommand}" Padding="10,3" Margin="0,0,6,0" ToolTip="Tageslog öffnen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE9F9;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Log" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleDebugCommand}" ToolTip="Schließen (F3, Esc)"
                                AutomationProperties.Name="Debug-Infos schließen">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xEBE8;" Margin="0,0,8,0" />
                        <TextBlock Text="Debug-Infos" FontWeight="SemiBold" />
                        <TextBlock Text="F3" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </DockPanel>
                <TextBox Text="{Binding DebugText, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Debug-Infos" />
            </DockPanel>
        </Border>

        <Grid Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}, ConverterParameter=!}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================== Navigation links ============================== -->
            <Grid Grid.Column="0" Margin="8,10,8,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,4,8,14">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox x:Name="Nav" Grid.Row="1" Style="{StaticResource NavList}" ItemsSource="{Binding NavItems}"
                         SelectionChanged="OnNavSelected" AutomationProperties.Name="Abschnitte">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" Margin="0,0,12,0" FontSize="15" />
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="8,8,8,0">
                    <CheckBox Content="Erweitert anzeigen" IsChecked="{Binding ShowAdvanced}" Margin="0,0,0,8"
                              Visibility="{Binding HasAdvanced, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Left" Command="{Binding OpenUserFileCommand}"
                            ToolTip="{Binding UserFilePath}" Margin="-6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE70F;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="JSON direkt öffnen" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Left" Command="{Binding OpenUserFolderCommand}"
                            ToolTip="{Binding UserFilePath}" Margin="-6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Ordner der Einstellungen" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Left" Command="{Binding OpenOtherCommand}"
                            Visibility="{Binding CanOpenOther, Converter={StaticResource BoolToVis}}" Margin="-6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="Andere App öffnen…" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="0,8,0,0" FontSize="11.5">
                        <Hyperlink Command="{Binding OpenRepoCommand}" TextDecorations="None"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   ToolTip="{Binding VersionTooltip}">
                            <Run Text="{Binding VersionText, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- ============================== Inhalt rechts ============================== -->
            <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource LayerFillColorDefaultBrush}">
                <Grid Margin="28,18,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Kopf: Titel, Suche, Alle | Geändert -->
                    <Grid Grid.Row="0" Margin="0,0,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Einstellungen" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Grid Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left">
                            <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="30,5,28,5" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Einstellungen durchsuchen" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0"
                                       HorizontalAlignment="Left" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding SearchPlaceholder}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}, ConverterParameter=!}" />
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,3,0"
                                    Command="{Binding ClearSearchCommand}" AutomationProperties.Name="Suche löschen"
                                    Visibility="{Binding HasSearch, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="10" />
                            </Button>
                        </Grid>
                        <Border Grid.Column="2" CornerRadius="7" Padding="3" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChangedFilter" Content="Alle"
                                             IsChecked="{Binding ShowAll}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="ChangedFilter" Content="{Binding ChangedLabel}"
                                             IsChecked="{Binding ShowChangedOnly}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Filter-Chips -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Chips}" Margin="0,0,16,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChipViewModel}">
                                <RadioButton Style="{StaticResource Chip}" GroupName="Chips" IsChecked="{Binding IsSelected}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Text="{Binding Count}" Margin="6,0,0,0" FontWeight="Normal"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Banner -->
                    <StackPanel Grid.Row="2" Margin="0,0,16,0">
                        <Border Visibility="{Binding HasUserFileError, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10"
                                Padding="14,10" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                            <StackPanel>
                                <TextBlock Text="Die Einstellungsdatei ist kaputt. Es wird nichts gespeichert, bis sie repariert ist."
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding UserFileError}" TextWrapping="Wrap" Margin="0,4,0,8" Style="{StaticResource SecondaryText}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Im Texteditor öffnen" Command="{Binding OpenUserFileCommand}" Padding="12,4" Margin="0,0,8,0" />
                                    <Button Content="Sicherung anlegen und neu beginnen" Command="{Binding BackupBrokenCommand}" Padding="12,4" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Visibility="{Binding HasWriteBlocked, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10"
                                Padding="14,10" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" Margin="0,0,10,0" />
                                    <TextBlock Text="Nur Ansicht: Die Einstellungen können hier nicht gespeichert werden."
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Text="{Binding WriteBlockedReason}" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                        </Border>
                        <Border Visibility="{Binding IsReadOnlyByOption, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10"
                                Padding="14,8" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" Margin="0,0,10,0" />
                                <TextBlock Text="Nur Ansicht (--readonly)." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10"
                                Padding="14,8" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE946;" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding RootHint}" Style="{StaticResource SecondaryText}" Margin="0,0,0,10"
                                   Visibility="{Binding HasRootHint, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Karten -->
                    <ScrollViewer x:Name="Scroller" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  SizeChanged="OnScrollerSizeChanged" ScrollChanged="OnScrollerScrollChanged">
                        <StackPanel x:Name="CardsPanel" Margin="0,4,16,24">
                            <!-- Favoriten -->
                            <StackPanel x:Name="FavoritesBlock" Visibility="{Binding FavoritesVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE734;" Margin="0,0,8,0" FontSize="14" />
                                    <TextBlock Text="Favoriten" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Favorites}" ItemTemplate="{StaticResource FieldCard}"
                                              ItemsPanel="{StaticResource CardGrid}" Focusable="False" />
                            </StackPanel>

                            <!-- Abschnitte -->
                            <ItemsControl x:Name="SectionList" ItemsSource="{Binding Sections}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SectionViewModel}">
                                        <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding VisibleCount}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,0,8,4"
                                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                            <Border Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" Margin="0,2,8,8"
                                                    Padding="10,6" CornerRadius="5"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE946;" FontSize="12" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource SecondaryText}" />
                                                </StackPanel>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Fields}" ItemTemplate="{StaticResource FieldCard}"
                                                          ItemsPanel="{StaticResource CardGrid}" Focusable="False" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Nichts gefunden." Margin="0,24,0,0" Style="{StaticResource SecondaryText}" FontSize="14"
                                       Visibility="{Binding NothingFound, Converter={StaticResource BoolToVis}}" />

                            <!-- Hinweise zur Konfiguration (Descriptor-Warnungen) -->
                            <Expander Header="{Binding WarningsTitle}" Margin="0,24,0,0"
                                      Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat=• {0}}" Style="{StaticResource SecondaryText}" Margin="0,0,0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
