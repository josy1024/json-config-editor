{
  "formatVersion": 1,
  "app": {
    "name": "PraxisRecorder",
    "title": "PraxisRecorder Einstellungen",
    "base": "appsettings.json",
    "userFile": "%APPDATA%\\PraxisRecorder\\appsettings.local.json",
    "machineFile": "%ProgramData%\\PraxisRecorder\\appsettings.json"
  },
  "favorites": [
    "Output:RootPath",
    "Live:ChunkSeconds",
    "Recording:SegmentMinSeconds",
    "Recording:MaxMinutes",
    "Live:Model",
    "Quality:Model"
  ],
  "sections": {
    "Audio": { "label": "Audio", "order": 1, "icon": "mic" },
    "Output": { "label": "Ausgabe", "order": 2, "icon": "folder" },
    "Recording": { "label": "Aufnahme", "order": 3, "icon": "record" },
    "Models": { "label": "Modelle", "order": 5, "icon": "model" },
    "Live": { "label": "Live", "order": 6, "icon": "waveform" },
    "Quality": { "label": "Quality", "order": 7, "icon": "quality" },
    "Archive": { "label": "Archiv", "order": 8, "icon": "archive" }
  },
  "fields": {
    "Audio:PreferredDevices": { "label": "Mikro-Prioliste", "list": { "itemLabel": "Name", "itemDetail": ["LastSeen"] } },
    "Audio:MaxGapFillSeconds": { "label": "Lücke mit Stille füllen bis", "type": "number", "unit": "s", "min": 0 },
    "Audio:StallSeconds": { "label": "Watchdog", "type": "number", "unit": "s", "min": 0, "zeroMeans": "Watchdog aus" },

    "Output:RootPath": { "label": "Speicherort", "description": "Hier landen die Aufnahmen, darunter ein Ordner pro Tag. Umgebungsvariablen wie %USERPROFILE% gehen.", "type": "path", "pathKind": "folder", "mustExist": false,
                         "emptyMeans": "Dokumente\\PraxisRecorder", "warnCloudFolder": true },
    "Output:QualityTimestamps": { "label": "Zeitstempel in quality.md", "description": "\"startstop\" = nur Start/Ende oben, Text als Absätze. \"line\" = [hh:mm:ss] vor jeder Zeile." },
    "Output:HistoryCount": { "label": "Sessions im Dropdown", "min": 1 },

    "Recording:MaxMinutes": { "label": "Auto-Stop nach", "type": "number", "unit": "min", "min": 0, "zeroMeans": "unbegrenzt" },
    "Recording:DiskWarnGb": { "label": "Warnen unter", "type": "number", "unit": "GB", "min": 0 },
    "Recording:DiskStopMb": { "label": "Stoppen unter", "type": "number", "unit": "MB", "min": 0 },
    "Recording:RecoverDays": { "label": "Offene Sessions nachverarbeiten", "unit": "Tage", "min": 0 },
    "Recording:SegmentMinSeconds": { "label": "Segment mindestens", "type": "number", "unit": "s", "min": 1 },
    "Recording:SegmentMaxSeconds": { "label": "Segment höchstens", "type": "number", "unit": "s", "min": 1, "advanced": true },
    "Recording:SilenceThresholdDb": { "label": "Stille unter", "type": "number", "unit": "dB", "max": 0, "advanced": true },
    "Recording:SilenceMinMs": { "label": "Stille mindestens", "type": "number", "unit": "ms", "min": 0, "advanced": true },
    "Recording:FlushSeconds": { "label": "WAV-Header nachziehen alle", "type": "number", "unit": "s", "min": 0.1, "advanced": true },

    "Models:Directory": { "label": "Modellordner", "type": "path", "pathKind": "folder" },
    "Models:Backend": { "label": "Rechen-Backend", "restartRequired": true,
                        "description": "\"auto\" = GPU per Vulkan (Intel Arc/Iris, AMD, NVIDIA) wenn möglich, sonst CPU. \"vulkan\" = wie auto, warnt bei CPU. \"cpu\" = nie GPU." },
    "Models:GpuDevice": { "label": "GPU-Nummer", "min": 0, "restartRequired": true, "advanced": true },
    "Models:Language": { "label": "Sprache" },
    "Models:VocabularyFile": { "label": "Fachwortliste", "type": "path", "pathKind": "file", "relativeTo": "base" },

    "Live:Enabled": { "label": "Live-Text" },
    "Live:Model": { "label": "Live-Modell" },
    "Live:ChunkSeconds": { "label": "Live-Chunk-Länge", "type": "number", "unit": "s", "min": 1 },
    "Live:Threads": { "label": "Live-Threads", "min": 1 },
    "Live:MaxBacklogChunks": { "label": "Live-Rückstau höchstens", "unit": "Chunks", "min": 1, "advanced": true },

    "Quality:Enabled": { "label": "Quality-Transkript" },
    "Quality:Model": { "label": "Quality-Modell" },
    "Quality:Threads": { "label": "Threads nach der Aufnahme", "min": 0, "zeroMeans": "automatisch (Kerne − 2)" },
    "Quality:ThreadsWhileRecording": { "label": "Threads während der Aufnahme", "min": 0, "zeroMeans": "automatisch" },
    "Quality:PauseWhileRecording": { "label": "Quality wartet während der Aufnahme" },

    "Archive:Format": { "label": "Archivformat", "description": "\"opus\" = audio.opus nach fertigem Quality (1 h ca. 11 MB). \"none\" = nur WAV." },
    "Archive:BitrateKbps": { "label": "Opus-Bitrate", "unit": "kbps", "min": 6, "max": 510 },
    "Archive:DeleteSegmentsAfterArchive": { "label": "WAV-Segmente nach Opus löschen" }
  }
}
