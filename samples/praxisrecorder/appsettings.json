{
  "Audio": {
    // Mikro-Prioliste pflegst du am besten per Button "Config öffnen" in appsettings.local.json.
    // Die ist vorausgefüllt mit allen angesteckten Mikros. Hier bleibt die Liste leer,
    // sonst mischt .NET die beiden Listen nach Position zusammen.
    "PreferredDevices": [],
    // Lücke beim Mikrowechsel bis so lange mit Stille füllen (Zeitstempel bleiben uhrgenau)
    "MaxGapFillSeconds": 60,
    // Watchdog: so viele Sekunden keine Audiodaten = Mikro gilt als weg, Umschalten. 0 = aus
    "StallSeconds": 5
  },
  "Output": {
    // leer = Desktop\PraxisRecorder, darunter ein Ordner pro Tag
    "RootPath": "",
    // quality.md: "startstop" = nur Start/Ende oben, Text als Absätze. "line" = [hh:mm:ss] vor jeder Zeile
    "QualityTimestamps": "startstop",
    // so viele der letzten Sessions im Session-Dropdown
    "HistoryCount": 10
  },
  "Recording": {
    // Auto-Stop nach X Minuten, 0 = unbegrenzt
    "MaxMinutes": 0,
    "DiskWarnGb": 2,
    "DiskStopMb": 500,
    // beim Start offene Sessions der letzten N Tage nachverarbeiten
    "RecoverDays": 7,
    "SegmentMinSeconds": 25,
    "SegmentMaxSeconds": 45,
    "SilenceThresholdDb": -40,
    "SilenceMinMs": 300,
    "FlushSeconds": 1
  },
  "Models": {
    "Directory": "%LOCALAPPDATA%\\PraxisRecorder\\models",
    // auto = GPU per Vulkan (Intel Arc/Iris, AMD, NVIDIA) wenn möglich, sonst CPU. cpu = nie GPU. Gilt nach Neustart.
    "Backend": "auto",
    "GpuDevice": 0,
    "Language": "de",
    "VocabularyFile": "vocab.txt"
  },
  // Modelle: Dateiname aus dem Modellordner. Ändern in appsettings.local.json greift ohne Neustart.
  // Mit GPU geht live auch ggml-large-v3-turbo-q5_0.bin, RTF im Fenster beobachten.
  "Live": {
    "Enabled": true,
    "Model": "ggml-base-q5_1.bin",
    "ChunkSeconds": 10,
    "Threads": 2,
    "MaxBacklogChunks": 3
  },
  "Quality": {
    "Enabled": true,
    // quantisiert (q5) spart RAM und ist auf der CPU schneller. Alternative für Dialekt: ggml-large-v3-turbo-q5_0.bin
    "Model": "ggml-large-v3-turbo-q5_0.bin",
    // nach der Aufnahme: 0 = Kerne - 2 (UI und Windows atmen lassen)
    "Threads": 0,
    // während der Aufnahme: 0 = Kerne - 2 - Live-Threads
    "ThreadsWhileRecording": 0,
    // true = Quality wartet, solange aufgenommen wird
    "PauseWhileRecording": false
  },
  "Archive": {
    // "opus" = audio.opus nach fertigem Quality (1 h ca. 11 MB), "none" = nur WAV
    "Format": "opus",
    "BitrateKbps": 24,
    // WAV-Segmente nach fertigem Opus löschen (json bleibt)
    "DeleteSegmentsAfterArchive": false
  }
}
